NOMAN=	# define

# Firmware for the iwx driver. The driver names two more images for the
# MA-A0 "fm" family (iwx-ma-a0-fm-a0-89.ucode and iwx-ma-a0-fm-a0.pnvm);
# they are not in the linux-firmware release these files come from.
FILES=	dist/iwx-Qu-b0-hr-b0-77.ucode dist/iwx-Qu-b0-jf-b0-77.ucode \
	dist/iwx-Qu-c0-hr-b0-77.ucode dist/iwx-Qu-c0-jf-b0-77.ucode \
	dist/iwx-QuZ-a0-hr-b0-77.ucode dist/iwx-QuZ-a0-jf-b0-77.ucode \
	dist/iwx-bz-b0-gf-a0-100.ucode dist/iwx-bz-b0-gf-a0.pnvm \
	dist/iwx-cc-a0-77.ucode dist/iwx-ma-b0-gf-a0-89.ucode \
	dist/iwx-ma-b0-gf-a0.pnvm dist/iwx-ma-b0-gf4-a0-89.ucode \
	dist/iwx-ma-b0-gf4-a0.pnvm dist/iwx-ma-b0-hr-b0-89.ucode \
	dist/iwx-so-a0-gf-a0-77.ucode dist/iwx-so-a0-gf-a0.pnvm \
	dist/iwx-so-a0-gf4-a0-77.ucode dist/iwx-so-a0-gf4-a0.pnvm \
	dist/iwx-so-a0-hr-b0-77.ucode dist/iwx-so-a0-jf-b0-77.ucode \
	dist/iwx-ty-a0-gf-a0-77.ucode dist/iwx-ty-a0-gf-a0.pnvm

FILESDIR=	${FIRMWAREDIR}/if_iwx

.include <bsd.files.mk>
